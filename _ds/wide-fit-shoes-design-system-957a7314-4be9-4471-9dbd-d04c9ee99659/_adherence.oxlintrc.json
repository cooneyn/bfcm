{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "campaign/**",
              "design-canvas.jsx",
              "ios-frame.jsx",
              "preview/**",
              "tweaks-panel.jsx",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Swiss 721 BT|Hanken Grotesk|Lexend|Playfair Display|DM Sans))/i]",
        "message": "Font not provided by the design system. Available: Swiss 721 BT, Hanken Grotesk, Lexend, Playfair Display, DM Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='CollectionGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|subheading|products|cols|key|ref|className|style|children)$/]",
        "message": "<CollectionGrid> doesn't accept that prop. Declared props: heading, subheading, products, cols."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|ctaText|ctaSecondary|bgColor|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: title, subtitle, ctaText, ctaSecondary, bgColor."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Nav'] > JSXAttribute > JSXIdentifier[name!=/^(?:dark|cartCount|key|ref|className|style|children)$/]",
        "message": "<Nav> doesn't accept that prop. Declared props: dark, cartCount."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|name|price|originalPrice|discount|sale|waterproof|rating|reviewCount|sizes|widths|swatches|images|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: brand, name, price, originalPrice, discount, sale, waterproof, rating, reviewCount, sizes, widths, swatches, images."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
